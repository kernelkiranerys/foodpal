# Copy to secrets.properties for local development builds.
# This file is gitignored — never commit real secrets.
#
# OFF_BASE_URL: override the production API URL for local dev/testing.
#   Defaults to https://thecodemill.dev if not set.
#
# Note: OFF_API_KEY is now a public constant in build.gradle.kts —
# not a secret. Abuse prevention is handled server-side via
# per-install UID registration + IP/UID rate limiting.

OFF_BASE_URL=https://thecodemill.dev
